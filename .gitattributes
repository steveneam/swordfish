# Box-bound files must stay LF: assert-hardening.sh is piped into bash over SSH,
# and cloud-init YAML is base64-encoded verbatim as user-data.
*.sh text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
# pre-backup hooks carry no extension (run-parts skips names with dots)
provisioning/backup/pre-backup.d/* text eol=lf
