#!/usr/bin/env bash
# 30-thalon-pglite-dump - pre-backup hook (thalon dogfood tenant): ask the
# running thalon-web container to dump its embedded PGlite DB before the
# snapshot. Same dump-before-snapshot invariant as 10-dokploy-postgres-dump:
# the raw live-DB dir (volume pg/**) is excluded in profiles.yaml - this dump
# is what restores. Spec: the thalon ask-backs note (2026-07-13): POST
# /api/admin/db-dump, Bearer DB_DUMP_TOKEN, 200 = trust, anything else = do
# NOT trust the dump -> we refuse to snapshot (exit 1 aborts run-parts).
#
# The call runs INSIDE the container (node's global fetch against loopback):
# no edge/BasicAuth in the path, no overlay-network reachability assumption,
# and the token never leaves the container's own env - nothing to distribute
# or drift. The image is node:24-slim: no curl, but node is by definition there.
#
# SELF-ARMING rot guard (pattern of 20-dogfood-sqlite-dumps): before the
# workload's first successful dump a missing container is a loud SKIP (fresh
# box, backups land before workloads); after it, absence is a hard FAIL -
# removing the workload must be an explicit edit here, never silent rot.
# Runs as root (systemd system unit) via profiles.yaml run-before.

set -euo pipefail

armed_marker=/var/backups/swordfish/.thalon-dump-armed
dump_rel=backups/pglite-dump.tar.gz

cid=$(docker ps --format '{{.ID}} {{.Names}}' | awk '/thalon-web/ {print $1; exit}')
if [ -z "$cid" ]; then
    if [ -e "$armed_marker" ]; then
        echo "FAIL: no running thalon-web container but its dump hook is armed - workload gone? edit this hook rather than letting backups rot"
        exit 1
    fi
    echo "SKIP: no running thalon-web container - workload not deployed on this box (guard arms at its first successful dump)"
    exit 0
fi

# in-container POST; 200-gate enforced by the exit code (spec: non-200 = do
# not trust the dump - and we do not snapshot without a trusted dump)
docker exec "$cid" node -e '
const t = process.env.DB_DUMP_TOKEN;
if (!t) { console.error("FAIL: DB_DUMP_TOKEN not set in container env"); process.exit(1); }
fetch(`http://127.0.0.1:${process.env.PORT || 3000}/api/admin/db-dump`,
      { method: "POST", headers: { Authorization: `Bearer ${t}` } })
  .then(async r => {
      const body = await r.text();
      console.log(`db-dump: ${r.status} ${body}`);
      process.exit(r.status === 200 ? 0 : 1);
  })
  .catch(e => { console.error(`FAIL: db-dump unreachable: ${e}`); process.exit(1); })
' || { echo "FAIL: thalon db-dump did not return 200 - refusing to snapshot without a trusted dump"; exit 1; }

# belt over the 200 braces: the artifact must exist in the volume, non-empty,
# written just now (the endpoint writes temp-file + rename, so mtime is real)
vol=$(docker volume ls -q --filter name=thalon-data | head -n1)
[ -n "$vol" ] || { echo "FAIL: thalon-web runs but no thalon-data volume found"; exit 1; }
mp=$(docker volume inspect --format '{{.Mountpoint}}' "$vol")
dump="$mp/$dump_rel"
[ -s "$dump" ] || { echo "FAIL: $dump missing or empty after a 200"; exit 1; }
age=$(( $(date +%s) - $(stat -c %Y "$dump") ))
[ "$age" -le 300 ] || { echo "FAIL: $dump is ${age}s old - a 200 without a fresh artifact"; exit 1; }

touch "$armed_marker"
echo "OK: thalon pglite dumped -> $dump ($(stat -c%s "$dump") bytes, ${age}s old)"
