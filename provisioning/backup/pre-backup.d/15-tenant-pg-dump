#!/usr/bin/env bash
# 15-tenant-pg-dump - pre-backup hook: consistent dump of the shared tenant
# Postgres (tenant-pg, provisioning/dokploy/tenant-pg.sh) before the snapshot.
# pg_dumpall captures ROLES as well as every tenant database - one artifact
# restores the whole service. The raw service volume stays OUT of the backup
# set, same reasoning as 10-dokploy-postgres-dump: file-level backup of a
# live DB is not consistent; this dump is what restores (the drill proves it).
#
# SELF-ARMING rot guard (pattern: 20-dogfood-sqlite-dumps): on a box where
# tenant-pg has never been dumped, a missing container is a loud SKIP
# (backups land BEFORE workloads). The moment the first dump lands, absence
# becomes a hard FAIL: removing the service must be an explicit, tracked
# edit here - never silent rot.
# Runs as root (systemd system unit) via profiles.yaml run-before.

set -euo pipefail

dump_dir=/var/backups/swordfish
out="$dump_dir/tenant-pg.dumpall.sql.gz"
mkdir -p "$dump_dir"

# resolved by name fragment - Dokploy suffixes the immutable appName
# (tenant-pg-o7ijjh on syd2; runbooks/dogfood.md)
cid=$(docker ps --filter name=tenant-pg --format '{{.ID}}' | head -n1)
if [ -z "$cid" ]; then
    if [ -e "$out" ]; then
        echo "FAIL: no container matching 'tenant-pg' but a previous dump exists - workload gone? edit this hook rather than letting backups rot"
        exit 1
    fi
    echo "SKIP: no container matching 'tenant-pg' yet - workload not deployed on this box (guard arms at its first successful dump)"
    exit 0
fi

# write complete, then move into place - a snapshot can never catch a torn dump
docker exec "$cid" pg_dumpall -U swordfish | gzip > "$out.tmp"
[ -s "$out.tmp" ] || { echo "FAIL: dump came out empty"; exit 1; }
zcat "$out.tmp" | head -5 | grep -q 'PostgreSQL database cluster dump' \
    || { echo "FAIL: dump does not look like a pg_dumpall artifact"; exit 1; }
mv -f "$out.tmp" "$out"
echo "OK: tenant-pg dumped ($(stat -c%s "$out") bytes)"
