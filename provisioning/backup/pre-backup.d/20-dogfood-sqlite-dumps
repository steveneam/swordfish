#!/usr/bin/env bash
# 20-dogfood-sqlite-dumps - pre-backup hook (Bucket 4): consistent SQLite
# dumps of the dogfood monitoring state before the snapshot - Uptime Kuma
# (monitor defs, push token, ntfy config) + Beszel hub (PocketBase). The raw
# volumes stay OUT of the backup set, same reasoning as
# 10-dokploy-postgres-dump: file-level backup of a live DB is not consistent;
# the dump is what restores.
#
# sqlite3 runs on the HOST (phase7-backups.sh installs it) - dumps must not
# depend on what happens to be inside an app image. Volumes are resolved by
# name fragment because Dokploy suffixes its compose project names.
#
# SELF-ARMING rot guard: on a box where a workload has never been dumped
# (backups land BEFORE workloads - a fresh box legitimately has no kuma/beszel
# yet, hit live on syd2 2026-07-08) a missing volume is a loud SKIP. The moment
# the workload's first dump lands, absence becomes a hard FAIL: removing a
# workload must be an explicit, tracked edit here - never silent rot.
# Runs as root (systemd system unit) via profiles.yaml run-before.

set -euo pipefail

# SELF-ARM (2026-07-17): phase7-backups.sh ships EVERY hook to EVERY box, so a
# hook must no-op where its dependency is absent rather than hard-fail. This one
# needs Docker; cockpit-class boxes (syd3/syd4) have none by charter. Without
# this guard the hook exits 127 and `run-parts --exit-on-error` fails the WHOLE
# pre-backup chain - which is exactly what happened on syd4 when it gained its
# first hook that DOES belong there (thalon's native dev-postgres dump).
# A SKIP is correct and must be loud; a hard failure here is a self-inflicted
# backup outage on a box that simply has nothing of this kind to dump.
command -v docker >/dev/null 2>&1 || { echo "SKIP: no docker on $(hostname -s) (cockpit-class) - nothing of this kind to dump"; exit 0; }


dump_dir=/var/backups/swordfish
mkdir -p "$dump_dir"

dump_volume_dbs() { # volume-name-fragment out-prefix
    local vol mp found=0 db out
    vol=$(docker volume ls -q --filter "name=$1" | head -n1)
    if [ -z "$vol" ]; then
        if ls "$dump_dir/$2-"*.db >/dev/null 2>&1; then
            echo "FAIL: no docker volume matching '$1' but previous '$2' dumps exist - workload gone? edit this hook rather than letting backups rot"
            exit 1
        fi
        echo "SKIP: no docker volume matching '$1' yet - workload not deployed on this box (guard arms at its first successful dump)"
        return 0
    fi
    mp=$(docker volume inspect --format '{{.Mountpoint}}' "$vol")
    for db in "$mp"/*.db; do
        [ -e "$db" ] || continue
        found=1
        out="$dump_dir/$2-$(basename "$db")"
        # write complete, then move into place - a snapshot can never catch a torn dump
        sqlite3 "$db" ".backup '$out.tmp'"
        [ -s "$out.tmp" ] || { echo "FAIL: dump of $db came out empty"; exit 1; }
        mv -f "$out.tmp" "$out"
        echo "OK: $db -> $out ($(stat -c%s "$out") bytes)"
    done
    [ "$found" -eq 1 ] || { echo "FAIL: no *.db files found in volume $vol"; exit 1; }
}

dump_volume_dbs kuma-data kuma
dump_volume_dbs beszel-data beszel
