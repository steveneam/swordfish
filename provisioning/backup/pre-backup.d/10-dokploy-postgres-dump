#!/usr/bin/env bash
# 10-dokploy-postgres-dump - pre-backup hook (Bucket 3): dump the control-plane
# Postgres before the snapshot. File-level backup of a running DB volume is not
# consistent - this dump is what restores; the raw dokploy-postgres volume is
# deliberately NOT in the backup set (profiles.yaml).
#
# THE stateful-workload pattern: dump-before-snapshot. Future stateful services
# get their own executable in this directory. Filenames carry NO extension on
# purpose - run-parts silently skips names containing dots.
# Runs as root (systemd system unit) via profiles.yaml run-before.

set -euo pipefail

# SELF-ARM (2026-07-17): phase7-backups.sh ships EVERY hook to EVERY box, so a
# hook must no-op where its dependency is absent rather than hard-fail. This one
# needs Docker; cockpit-class boxes (syd3/syd4) have none by charter. Without
# this guard the hook exits 127 and `run-parts --exit-on-error` fails the WHOLE
# pre-backup chain - which is exactly what happened on syd4 when it gained its
# first hook that DOES belong there (thalon's native dev-postgres dump).
# A SKIP is correct and must be loud; a hard failure here is a self-inflicted
# backup outage on a box that simply has nothing of this kind to dump.
command -v docker >/dev/null 2>&1 || { echo "SKIP: no docker on $(hostname -s) (cockpit-class) - nothing of this kind to dump"; exit 0; }

# SELF-ARMING rot guard (2026-07-25, pattern: 15-tenant-pg-dump): syd4 gained
# Docker on 07-23 (selom's localhost-only dev Nango), so `command -v docker`
# alone no longer separates control-plane boxes from workspace boxes - this
# hook cleared the guard above, found no dokploy-postgres, and hard-failed
# syd4's WHOLE nightly chain two nights running (07-23/07-24, zero snapshots).
# A missing container is a loud SKIP until the first dump lands; after that,
# absence stays a hard FAIL - on the real control-plane box a vanished
# dokploy-postgres means the control plane is DOWN, and snapshotting a stale
# dump as if fresh would be silent rot.

dump_dir=/var/backups/swordfish
out="$dump_dir/dokploy-postgres.sql.gz"
cid=$(docker ps --filter label=com.docker.swarm.service.name=dokploy-postgres --format '{{.ID}}' | head -n1)
if [ -z "$cid" ]; then
    if [ -e "$out" ]; then
        echo "FAIL: dokploy-postgres container not running but a previous dump exists - control-plane down? refusing to snapshot a stale dump"
        exit 1
    fi
    echo "SKIP: no dokploy-postgres container - not a Dokploy control-plane box (guard arms at its first successful dump)"
    exit 0
fi

mkdir -p "$dump_dir"
# write complete, then move into place - a snapshot can never catch a torn dump
docker exec "$cid" pg_dump -U dokploy -d dokploy | gzip > "$out.tmp"
[ -s "$out.tmp" ] || { echo "FAIL: dump came out empty"; exit 1; }
mv -f "$out.tmp" "$out"
echo "OK: dokploy-postgres dumped ($(stat -c%s "$out") bytes)"
